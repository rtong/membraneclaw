{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SWRO WaterTAP skill trace",
  "type": "object",
  "required": ["task_family", "states", "final_recommendation", "verification_status"],
  "properties": {
    "task_family": {"type": "string"},
    "states": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["state_id", "status", "evidence"],
        "properties": {
          "state_id": {"type": "string"},
          "status": {"enum": ["complete", "partial", "failed", "not_applicable"]},
          "evidence": {"type": "string"},
          "tool_calls": {"type": "array"}
        }
      }
    },
    "constraint_table": {"type": "array"},
    "final_recommendation": {"type": "string"},
    "verification_status": {"enum": ["directly_simulated", "partly_estimated", "unverified"]},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}

