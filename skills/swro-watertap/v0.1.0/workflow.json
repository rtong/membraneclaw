{
  "workflow_id": "swro-watertap-core",
  "version": "0.1.0",
  "initial_state": "classify_task",
  "states": [
    {"id": "classify_task", "required_outputs": ["task_family", "decision_variable", "objective"]},
    {"id": "extract_and_normalize", "required_outputs": ["fixed_inputs", "constraints", "requested_outputs", "unit_conversions"]},
    {"id": "map_tool_arguments", "required_outputs": ["tool_arguments", "missing_inputs", "assumptions"]},
    {"id": "run_baseline", "required_outputs": ["baseline_arguments", "baseline_tool_result", "tool_status"]},
    {"id": "analyze_margin", "required_outputs": ["derived_limits", "constraint_margins", "active_constraint"]},
    {"id": "search_boundary", "required_outputs": ["candidate_points", "feasible_bracket", "refinement_method"]},
    {"id": "validate_constraints", "required_outputs": ["final_constraint_table", "all_constraints_pass"]},
    {"id": "form_engineering_judgment", "required_outputs": ["boundary_value", "recommended_value", "neighbor_comparison"]},
    {"id": "self_check_and_report", "required_outputs": ["completeness_check", "epistemic_status", "final_answer"]}
  ],
  "allowed_terminal_states": ["self_check_and_report"],
  "failure_policy": {
    "missing_required_input": "stop_and_report",
    "tool_error": "repair_once_then_report",
    "unbracketed_boundary": "report_as_unverified_estimate",
    "constraint_value_missing": "mark_unavailable_not_pass"
  }
}

