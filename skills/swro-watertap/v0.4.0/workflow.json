{
  "workflow_id": "swro-watertap-scaling",
  "version": "0.4.0",
  "default_call_budget": 5,
  "states": [
    {"id": "preflight", "required": ["task_family", "decision_variable", "fixed_inputs", "constraints", "requested_outputs"]},
    {"id": "tool_selection", "required": ["correct_tool", "complete_arguments"]},
    {"id": "baseline", "required": ["echo_check", "baseline_outputs", "baseline_margins"]},
    {"id": "bounded_candidates", "required": ["fixed_inputs_unchanged", "all_explicit_candidates_tested"]},
    {"id": "unrounded_final_check", "required": ["all_constraints_checked", "requested_outputs_complete"]},
    {"id": "single_final_report", "required": ["six_sections", "no_followup_tool_call", "no_repetition"]}
  ],
  "recipe_requirements": {
    "pressure_selection": ["minimum_flux", "first_deficit", "two_point_slope", "direct_final_verification"],
    "membrane_degradation": ["rejection_derived_limit", "strict_active_limit", "normal_margin", "unrounded_boundary_check"],
    "scaling_acid_optimization": ["complete_composition", "pressure_comparison", "all_requested_acid_candidates", "basic_vs_margin_recommendation"]
  }
