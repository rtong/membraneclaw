# Remote OpenWebUI site, without a trailing slash.
OPENWEBUI_BASE_URL=https://your-openwebui.example.com

# Create this in OpenWebUI: Settings -> Account -> API Keys.
OPENWEBUI_API_KEY=replace-me

# Exact model/preset IDs as they appear in OpenWebUI.
OPENWEBUI_MODEL_BASELINE=baseline
OPENWEBUI_MODEL_TOOLS=tools
OPENWEBUI_MODEL_TOOLS_RAG=tools-rag

# Optional paper side experiment. Create two separate OpenWebUI presets with the
# same base model, WaterTAP tools, and Knowledge collection as tools-rag. Attach
# only the indicated immutable Skill clone to each preset.
OPENWEBUI_MODEL_TOOLS_RAG_SKILL_V060=tools-rag-solver-v060
OPENWEBUI_MODEL_TOOLS_RAG_SKILL_V089=tools-rag-solver-v089

# A human-maintained immutable label for the Knowledge snapshot used by Tools+RAG.
# Example: watertap-kb-2026-08-06-r1
OPENWEBUI_RAG_VERSION=replace-me

# Do not add OPENAI_API_KEY, CODEX_API_KEY, or WATERTAP_MCP_TOKEN. Teacher/judge
# reuse the local Codex ChatGPT-account login, and WaterTAP authorization comes
# from the account-level connected app rather than a project-local MCP entry.
