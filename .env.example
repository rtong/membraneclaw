VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=sk-replace-me
VLLM_MODEL=qwen3.5-9b
AGENT_API_KEY=sk-agent-replace-me
AGENT_FILES=
AGENT_CLIENT_TOOLS=
MCP_BEARER_TOKEN=
MCP_ALLOWED_HOSTS=
RO_MCP_URL=
MCP_OAUTH_APPROVAL_KEY=
MCP_PUBLIC_URL=
AGENT_MAX_INPUT_TOKENS=

# Google's official Workspace MCP servers (developers.google.com/workspace/guides/
# configure-mcp-servers). Web-application OAuth client from Google Cloud Console;
# run `.venv/bin/python -m agent.google_oauth login` once after setting these.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_PORT=8765
GOOGLE_MCP=on
GOOGLE_MCP_SERVERS=drive,sheets
GOOGLE_MCP_TOOLS=

# Shared secret with Open WebUI, so it can prove which user each request is for
# (agent/identity.py). Must match FORWARD_USER_INFO_HEADER_JWT_SECRET in the
# Open WebUI container; run_openwebui.sh passes this one through. Unset means no
# per-user identity, and therefore no per-user Google credentials.
FORWARD_USER_INFO_HEADER_JWT_SECRET=

# Where Google sends users back after they authorize, for the in-chat login flow.
# Must be registered verbatim on the OAuth client, must be reachable from the
# user's browser, and only this path should be routed publicly to the agent.
GOOGLE_OAUTH_PUBLIC_REDIRECT=

# Which of the REST Drive/Sheets tools to declare. Empty or "*" means all five.
GOOGLE_TOOLS=
