# Runs on temur (192.168.86.42), not on anton — the RO solve is CPU-only and does
# not belong on the GPU host. Install there:
#   sudo cp watertap-mcp.service /etc/systemd/system/
#   sudo systemctl enable --now watertap-mcp
#   tailscale serve --bg --https=8443 http://127.0.0.1:8002
[Unit]
Description=WaterTAP RO MCP server (streamable-http)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bayan
WorkingDirectory=/home/bayan/watertap-mcp
# MCP_BEARER_TOKEN and MCP_ALLOWED_HOSTS live here; the allowed-hosts list must
# name the tailnet host, or the SDK's DNS-rebinding check returns 421.
EnvironmentFile=/home/bayan/watertap-mcp/.env
Environment=MCP_TRANSPORT=streamable-http
# Loopback bind: Tailscale's proxy is the only way in.
Environment=MCP_HOST=127.0.0.1
Environment=MCP_PORT=8002
ExecStart=/home/bayan/watertap-mcp/.venv/bin/python server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
