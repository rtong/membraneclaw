        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Feed Flow Mass Kg S"
     },
     "feed_nacl_mass_frac": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Feed Nacl Mass Frac"
     },
     "feed_pressure_bar": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Feed Pressure Bar"
     },
     "feed_temperature_c": {
