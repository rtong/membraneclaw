 {
  "type": "function",
  "function": {
   "name": "simulate_swro_system",
   "description": "Simulate and cost a *full seawater RO desalination plant*.\n\nUse this \u2014 not simulate_ro \u2014 for any question about cost, energy, or the plant\nas a whole. It solves the whole train (pretreatment, high pressure pump, RO,\nenergy recovery, post-treatment) and reports **levelized cost of water in $/m3**\nand **specific energy consumption in kWh/m3**, which simulate_ro cannot produce\nbecause it models a single membrane unit with no pump, energy recovery or costing.\n\nEnergy recovery is chosen with erd_type: 'pressure_exchanger' (default, adds a\npressure exchanger and a booster pump) or 'pump_as_turbine'. The pxr/p2\nefficiencies apply only to the former and erd_efficiency only to the latter.\n\nSlower than simulate_ro \u2014 it solves the entire flowsheet twice. Any argument\nleft unset keeps its default (see describe_ro_parameters).\n\nReturns JSON. On failure returns {\"error\": ...} rather than raising.\n",
   "parameters": {
    "properties": {
     "erd_type": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Erd Type"
     },
     "feed_flow_m3_s": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Feed Flow M3 S"
     },
     "feed_tds_g_L": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Feed Tds G L"
     },
     "feed_tss_g_L": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Feed Tss G L"
     },
     "feed_temperature_c": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Feed Temperature C"
     },
     "ro_area_m2": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Ro Area M2"
     },
     "A_comp": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "A Comp"
     },
     "B_comp": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "B Comp"
     },
     "p1_pressure_bar": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "P1 Pressure Bar"
     },
     "p1_efficiency": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "P1 Efficiency"
     },
     "pxr_efficiency": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Pxr Efficiency"
     },
     "p2_efficiency": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "P2 Efficiency"
     },
     "erd_efficiency": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Erd Efficiency"
     }
    },
    "title": "simulate_swro_systemArguments",
    "type": "object"
   }
  }
 },
 {
  "type": "function",
  "function": {
   "name": "convert_units",
   "description": "Convert one number between units.\n\nSupported: mass flow (kg/s, t/h, kg/h; m3/h and m3/d of water at 1000 kg/m3), volume flow (m3/s, L/s, m3/h, m3/d, MGD), salinity as a mass fraction (mass fraction, g/kg, \u2030, %, mg/kg, ppm), concentration (g/L, mg/L, kg/m3, ppm), temperature (C, F), area (m2, ft2), pressure (bar, kPa, MPa, psi), water permeability A (m/s/Pa, LMH/bar), salt permeability B (m/s, LMH), flux (LMH, gfd), cost ($/m3, $/kgal), efficiency (fraction, %).\n\nReturns JSON {\"value\": ..., \"unit\": ...}. On failure returns {\"error\": ...} rather than raising.\n",
   "parameters": {
    "properties": {
     "value": {
      "title": "Value",
      "type": "number"
     },
     "from_unit": {
      "title": "From Unit",
      "type": "string"
     },
     "to_unit": {
      "title": "To Unit",
      "type": "string"
     }
    },
    "required": [
     "value",
     "from_unit",
     "to_unit"
    ],
    "title": "convert_unitsArguments",
    "type": "object"
   }
  }
 }
]
