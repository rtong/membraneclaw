# Remote OpenWebUI site, without a trailing slash.
OPENWEBUI_BASE_URL=https://your-openwebui.example.com

# Create this in OpenWebUI: Settings -> Account -> API Keys.
OPENWEBUI_API_KEY=replace-me

# Exact model/preset IDs as they appear in OpenWebUI.
OPENWEBUI_MODEL_BASELINE=baseline
OPENWEBUI_MODEL_ENVIRONMENT=environment
OPENWEBUI_MODEL_ENVIRONMENT_SKILL=environment-skill

# A human-maintained immutable label for the Knowledge snapshot used by Environment and
# Environment-Skill.
# Example: watertap-kb-2026-08-06-r1
OPENWEBUI_RAG_VERSION=replace-me

# Do not add OPENAI_API_KEY or CODEX_API_KEY. Teacher/judge reuse the local
# Codex ChatGPT-account login and deliberately refuse Platform API credentials.
