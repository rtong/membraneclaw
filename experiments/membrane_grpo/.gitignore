.venv/
__pycache__/
*.pyc
.pytest_cache/

# Training artefacts. Metrics and plots are the record and belong in git;
# adapter weights do not -- with two named exceptions, both 8.3 MiB.
#
# grpo-main-s0 is the deliverable checkpoint. grpo-probe-s0 is the control, and
# it is here because MEMO.md claims the two policies are behaviourally
# indistinguishable; checking that claim means loading both adapters and
# evaluating them, so keeping only one would leave the central comparison
# assertable but not verifiable. Everything else stays excluded.
runs/**/*.safetensors
!runs/grpo-main-s0/adapter/adapter_model.safetensors
!runs/grpo-probe-s0/adapter/adapter_model.safetensors
# The three Qwen3-1.7B runs, 25 MiB each. All three, because the ablation's
# claim is that ABLATE and PROBE behave alike while MAIN differs, and checking
# that independently means loading all three -- keeping only the winner would
# leave the comparison assertable but not verifiable.
!runs/q3-main-s0/adapter/adapter_model.safetensors
!runs/q3-ablate-s0/adapter/adapter_model.safetensors
!runs/q3-probe-s0/adapter/adapter_model.safetensors
# PEFT regenerates this boilerplate on every save_pretrained
runs/**/adapter/README.md
runs/**/*.bin
runs/**/*.pt
runs/**/checkpoint-*/
